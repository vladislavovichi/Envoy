ENVOY_JOURNAL_STORE=
ENVOY_TELEGRAM_TRANSPORT=
ENVOY_DATABASE_URL=
ENVOY_BOT_TOKEN=
ENVOY_AGENT_KEY=
ENVOY_MASTER_KEY=
ENVOY_GLOBAL_RATE=
ENVOY_PER_CHAT_RATE=
ENVOY_MAX_RETRY_AFTER=
ENVOY_TELEGRAM_API_BASE=
ENVOY_POSTGRES_USER=
ENVOY_POSTGRES_PASSWORD=
ENVOY_POSTGRES_DB=
ENVOY_POSTGRES_PORT=
ENVOY_TEST_DATABASE_URL=
ENVOY_OWNER_IDS=
ENVOY_DEFAULT_TIMEZONE=
ENVOY_AGENT_NAME=
ENVOY_LLM=
ENVOY_LLM_MODEL=
ENVOY_ANTHROPIC_API_KEY=
ENVOY_LLM_DAILY_TOKEN_BUDGET=
ENVOY_INBOUND_MAX_TEXT_LENGTH=
ENVOY_INBOUND_RATE_PER_MINUTE=
# Owner view: text (Phase 1 text cards, default) or widget (Telegram HTML widgets in the owner private chat, with text fallback).
ENVOY_OWNER_VIEW=
# Daily summary topic links: request (bot sends the link on tap, default) or direct (openTelegramLink plus a request button).
ENVOY_WIDGET_TOPIC_LINKS=
# Local hour (ENVOY_DEFAULT_TIMEZONE) from which the daily owner summary is sent, default 20.
ENVOY_SUMMARY_HOUR=
# Agent-to-agent protocol over bot-to-bot messages (phase 2), disabled by default.
ENVOY_AGENT_PROTOCOL=
# Numeric ID of this agent bot; defaults to the prefix of ENVOY_BOT_TOKEN.
ENVOY_AGENT_BOT_ID=
# Telegram user ID of the owner this agent represents; defaults to the only ENVOY_OWNER_IDS entry.
ENVOY_AGENT_OWNER_ID=
# Mini App owner API (signing challenges); disabled unless a port is set. Needs ENVOY_BOT_TOKEN for initData.
ENVOY_MINIAPP_HOST=
ENVOY_MINIAPP_PORT=
# Directory with the built Mini App (npm --prefix miniapp run build), served at /app/.
ENVOY_MINIAPP_STATIC=
# Public URL of the Mini App, shown in text fallbacks for the mandate widget.
ENVOY_MINIAPP_URL=
# Agent protocol rate limits (messages per minute) and retransmission interval in seconds.
ENVOY_AGENT_SESSION_RATE=
ENVOY_AGENT_PAIR_RATE=
ENVOY_AGENT_SENDER_RATE=
ENVOY_AGENT_RETRY_SECONDS=
