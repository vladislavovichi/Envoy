[importlinter]
root_packages =
    envoy
    tg_fake_api
include_external_packages = True

[importlinter:contract:composition]
name = Infrastructure implementations are imported only by composition root
type = forbidden
source_modules =
    envoy.domain
    envoy.ports
    envoy.crypto
    envoy.mandate
    envoy.engine
    envoy.journal
    envoy.security
    envoy.execution
    envoy.observability
    envoy.llm.ports
    envoy.llm.translator
    envoy.llm.validation
    envoy.llm.budget
    envoy.llm.fake
    envoy.app.application
    envoy.app.settings
    envoy.app.ports
    envoy.app.memory
    envoy.app.journal
    envoy.app.window
    envoy.app.renderer
    envoy.app.steps
    envoy.app.owner_flow
    envoy.app.session_flow
    envoy.app.execution_flow
    envoy.app.processor
    envoy.app.pipeline
    envoy.app.recovery
    envoy.app.runtime
    envoy.app.owner_view
    envoy.app.escalation
    envoy.app.widget_queries
    envoy.app.daily_summary
    envoy.app.locks
    envoy.widgets
    envoy.telegram.outbound
    envoy.telegram.ports
    envoy.telegram.dependencies
    envoy.telegram.memory
    envoy.telegram.links
    envoy.telegram.mapping
forbidden_modules =
    envoy.persistence
    envoy.telegram.adapter
    envoy.llm.claude
    anthropic

[importlinter:contract:domain]
name = Domain has no outward dependencies
type = forbidden
source_modules =
    envoy.domain
forbidden_modules =
    envoy.ports
    envoy.crypto
    envoy.mandate
    envoy.engine
    envoy.journal
    envoy.security
    envoy.execution
    envoy.llm
    envoy.telegram
    envoy.persistence
    envoy.app
    envoy.observability

[importlinter:contract:core]
name = Pure core cannot depend on adapters
type = forbidden
source_modules =
    envoy.crypto
    envoy.mandate
    envoy.engine
    envoy.execution
    envoy.journal
forbidden_modules =
    envoy.telegram
    envoy.persistence
    envoy.llm
    envoy.app
    aiogram
    sqlalchemy
    anthropic

[importlinter:contract:fake]
name = Fake Bot API is independent
type = independence
modules =
    envoy
    tg_fake_api
